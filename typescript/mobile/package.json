{
  "name": "bankd-mobile",
  "main": "./index.js",
  "version": "0.1.0",
  "scripts": {
    "build:bridge": "pnpm --dir penumbra-bridge-build build",
    "start": "pnpm build:bridge && expo start",
    "android": "pnpm build:bridge && expo run:android",
    "ios": "pnpm build:bridge && expo run:ios",
    "web": "pnpm build:bridge && expo start --web",
    "typecheck": "tsc --noEmit && tsc --project penumbra-bridge-build/tsconfig.json",
    "test:commonware": "node --import tsx --test lib/commonware/*.test.ts lib/penumbra-address.test.ts penumbra-bridge-build/commonware.test.ts",
    "export:web": "pnpm build:bridge && expo export --platform web",
    "export:native": "pnpm build:bridge && expo export --platform ios --platform android --output-dir dist-native",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@bankd/shared": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.28",
    "@scure/bip39": "^2.0.1",
    "@tanstack/react-query": "^5.90.21",
    "@types/qrcode": "^1.5.6",
    "buffer": "^6.0.3",
    "expo": "~55.0.6",
    "expo-asset": "^55.0.10",
    "expo-camera": "^55.0.18",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.10",
    "expo-dev-client": "^55.0.32",
    "expo-file-system": "^55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-linear-gradient": "~55.0.9",
    "expo-linking": "~55.0.8",
    "expo-local-authentication": "~55.0.9",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.9",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-web-browser": "~55.0.10",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "viem": "^2.47.4",
    "bech32": "^2.0.0",
    "@bankd/shieldd-web": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
