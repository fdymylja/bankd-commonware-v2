# Development defaults for the local compose stack (infra/docker-compose.yml).
# Loaded automatically by `next dev`; override per-machine in .env.local.

NEXT_PUBLIC_PENUMBRA_CHAIN_ID=9001
NEXT_PUBLIC_PENUMBRA_RPC_URL=http://localhost:27657
NEXT_PUBLIC_PENUMBRA_GRPC_URL=http://localhost:11317

# ORBIS StoreSecret gRPC-web endpoint (the orbis-web-proxy envoy service).
# Regulated transfers refuse to broadcast without this — their encrypted
# compliance seed packages must upload to ORBIS first.
NEXT_PUBLIC_ORBIS_GRPC_URL=http://localhost:50052
